# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงของคุณ

# Connection string จาก MongoDB Atlas (ฐานข้อมูลออนไลน์บนคลาวด์ ฟรี)
# สมัครได้ที่ https://www.mongodb.com/cloud/atlas/register
# รูปแบบ: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/community_leader_db?retryWrites=true&w=majority

# พอร์ตของเซิร์ฟเวอร์
PORT=3000
